{
  "$schema": "https://raw.githubusercontent.com/aharonyaircohen/Kody-Engine-Lite/main/kody.config.schema.json",
  "quality": {
    "typecheck": "pnpm tsc --noEmit",
    "lint": "pnpm lint",
    "lintFix": "",
    "formatFix": "",
    "testUnit": "pnpm exec vitest run --config ./vitest.config.mts --maxWorkers=2"
  },
  "git": {
    "defaultBranch": "main"
  },
  "github": {
    "owner": "aharonyaircohen",
    "repo": "Kody-Engine-Tester"
  },
  "agent": {
    "model": "minimax/MiniMax-M3",
    "modelMap": {
      "cheap": "minimax/MiniMax-M2.7-highspeed",
      "mid": "minimax/MiniMax-M2.7-highspeed",
      "strong": "minimax/MiniMax-M2.7"
    },
    "budgets": {
      "taskify": {
        "maxBudgetUsd": 15
      },
      "plan": {
        "maxBudgetUsd": 10
      },
      "build": {
        "maxBudgetUsd": 50
      },
      "verify": {
        "maxBudgetUsd": 5
      },
      "review": {
        "maxBudgetUsd": 10
      },
      "review-fix": {
        "maxBudgetUsd": 30
      },
      "ship": {
        "maxBudgetUsd": 5
      }
    }
  },
  "mcp": {
    "enabled": true,
    "servers": {},
    "stages": [
      "build",
      "review"
    ]
  },
  "devServer": {
    "command": "pnpm dev",
    "url": "http://localhost:3000"
  },
  "watch": {
    "enabled": true
  },
  "testRequirements": [
    {
      "pattern": "src/app/api/**/route.ts",
      "requireSibling": "{name}.test{ext}"
    }
  ],
  "release": {
    "releaseBranch": "main",
    "productionDeployRequired": false
  },
  "company": {
    "activeAgents": [
      "kody",
      "memory-steward",
      "documentation-lead"
    ],
    "activeCapabilities": [
      "review",
      "run",
      "fix",
      "extract-run-learning",
      "detect-memory-duplicates",
      "detect-memory-conflicts",
      "decide-memory-change",
      "apply-memory-changes",
      "verify-memory-change",
      "detect-stale-memory",
      "build-chat-knowledge-graph",
      "publish-chat-knowledge-tool",
      "documentation-draft",
      "define-documentation-brief",
      "collect-documentation-evidence",
      "design-documentation-set",
      "test-documentation-examples",
      "verify-documentation-accuracy",
      "review-documentation-quality",
      "revise-documentation",
      "publish-documentation",
      "verify-published-documentation",
      "detect-documentation-drift",
      "ci-health-check",
      "merge",
      "prepare-ci-repair"
    ],
    "activeWorkflows": [
      "chore",
      "learn-from-runs",
      "maintain-memory-quality",
      "build-chat-knowledge-graph",
      "maintain-documentation",
      "documentation-agency",
      "ci-repair",
      "review-merge"
    ]
  }
}